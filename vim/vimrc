" Vim config — managed by ~/dotfiles
" ~/.vimrc is a symlink to ~/dotfiles/vim/vimrc (created by install.sh).
"
" Leader key: , (comma)
"
" Key mappings cheat sheet:
"   ,w          save file               ,q          quit
"   ,ev         edit vimrc (vsplit)      ,sv         reload vimrc
"   ,r          search & replace         ,rc         search & replace (confirm)
"   ,g          go to definition (ALE)   ,b          list buffers (fzf)
"   ,l          search lines (buffer)    ,L          search lines (all buffers)
"   ,wf         search VimWiki           ,u          uppercase word
"   Ctrl-f      fuzzy find files         Ctrl-n      toggle NERDTree
"   Tab/S-Tab   next/prev buffer         Q           close buffer
"   Space       toggle fold              H/L         start/end of line
"   J/K         move 5 lines down/up     jk or kj    escape (insert mode)
"   Y           yank to end of line

set nocompatible        " Use Vim defaults, not Vi. Must be first — changes other options.
filetype plugin on      " Enable filetype-specific plugins (e.g., Python indent rules)

" ======================================
" Plugins (managed by vim-plug)
" ======================================
" vim-plug downloads plugins to ~/.vim/plugged/ on :PlugInstall.
" Add/remove plugins here, then run :PlugInstall or :PlugClean.
call plug#begin('~/.vim/plugged')

" --- Editing essentials (Tim Pope) ---
Plug 'tpope/vim-commentary'        " gc to comment/uncomment lines
Plug 'tpope/vim-repeat'            " make . (repeat) work with plugin commands
Plug 'tpope/vim-surround'          " cs'" to change surrounding ' to ", ds" to delete, ysiw" to add
Plug 'tpope/vim-fugitive'          " :Git blame, :Git diff, :Git log — git inside Vim

" --- Fuzzy finder (fzf) ---
" fzf is installed to ~/.fzf by install.sh; this plugin integrates it with Vim.
" See mappings below: Ctrl-f, ,b, ,l, ,L
Plug 'junegunn/fzf', { 'dir': '~/.fzf', 'do': './install --all' }
Plug 'junegunn/fzf.vim'

" --- File explorer (NERDTree) ---
" Ctrl-n to toggle. Shows directory tree in a sidebar.
Plug 'preservim/nerdtree'
Plug 'ryanoasis/vim-devicons'       " file type icons (requires Nerd Font in terminal)

" --- Colorscheme ---
Plug 'morhetz/gruvbox'              " warm dark theme with good contrast

" --- Visual enhancements ---
Plug 'machakann/vim-highlightedyank' " briefly highlight yanked text
Plug 'sheerun/vim-polyglot'         " syntax highlighting for 100+ languages

" --- Status line ---
Plug 'itchyny/lightline.vim'        " lightweight status bar (lighter than airline)

" --- Tmux integration ---
" Allows seamless C-h/j/k/l navigation between Vim splits and tmux panes.
" The tmux side of this is configured in tmux.conf.
Plug 'christoomey/vim-tmux-navigator'

" --- Code folding ---
Plug 'tmhedberg/SimpylFold'         " better Python code folding

" --- Linting & completion (ALE) ---
" ALE runs linters (flake8, pylsp) asynchronously. See ALE config section below.
Plug 'dense-analysis/ale'

" --- Text operations ---
Plug 'vim-scripts/ReplaceWithRegister'  " gr{motion} to replace with register contents

" --- Python REPL integration (vim-slime) ---
" Send code from Vim to a tmux pane running IPython.
" { 'for': 'python' } = only load when editing Python files.
Plug 'jpalardy/vim-slime', { 'for': 'python' }
Plug 'hanschen/vim-ipython-cell', { 'for': 'python' }

" --- Notes (VimWiki) ---
" ,wf to search wiki. `vw` alias in shell opens wiki index.
Plug 'vimwiki/vimwiki'
Plug 'godlygeek/tabular'            " :Tabularize to align text by pattern
Plug 'plasticboy/vim-markdown'       " better markdown syntax & folding

call plug#end()
" ======================================

" Leader key — pressed before mappings like ,w ,q ,r etc.
" Comma is easy to reach and doesn't conflict with built-in keys.
let mapleader = ','

" -----------------------------------------------------------------------------
"   Colors / Theme
" -----------------------------------------------------------------------------
syntax on               " enable syntax highlighting

" These escape sequences tell Vim how to send 24-bit (true color) codes
" to the terminal. Without them, gruvbox falls back to 256-color approximation.
let &t_8f="\<Esc>[38;2;%lu;%lu;%lum"   " set foreground color
let &t_8b="\<Esc>[48;2;%lu;%lu;%lum"   " set background color
set termguicolors       " use GUI colors in terminal (requires true color support)

" gruvbox_italic must be set BEFORE loading the colorscheme
let g:gruvbox_italic=1

set background=dark
colorscheme gruvbox

" Terminal escape sequences for italic text (needed for markdown emphasis).
let &t_ZH="\e[3m"      " start italic mode
let &t_ZR="\e[23m"     " end italic mode


" -----------------------------------------------------------------------------
"   Basic Settings
" -----------------------------------------------------------------------------
set autoindent                  " new lines inherit indent from previous line
set backspace=indent,eol,start  " allow backspace over indent, line breaks, and insert start
set belloff=all                 " disable all bell sounds
set conceallevel=2              " hide markup syntax (e.g., **bold** shows as bold in markdown)
set cursorline                  " highlight the line the cursor is on
set encoding=UTF-8              " default character encoding
set hlsearch                    " highlight all search matches (Enter to clear, see mapping below)
set laststatus=2                " always show status line (needed for lightline)
set matchpairs+=<:>             " add < > to bracket matching (% key jumps between pairs)
set noswapfile                  " don't create .swp files (avoids "swap file already exists" warnings)
set noshowmode                  " don't show --INSERT-- etc. (lightline shows this instead)
set number                      " show absolute line numbers
set relativenumber              " show relative line numbers (makes 5j, 10k easy to count)
set ruler                       " show line:column in bottom right
set scrolloff=3                 " keep 3 lines visible above/below cursor when scrolling
set showmatch                   " briefly jump to matching bracket when typing one
set showtabline=2               " always show the tab/buffer line at the top
set ttyfast                     " assume fast terminal connection (smoother scrolling)

" Indentation: 4 spaces, no tabs
set expandtab                   " pressing Tab inserts spaces, not a tab character
set shiftwidth=4                " >> and << indent by 4 spaces
set tabstop=4                   " display tab characters as 4 spaces wide


" -----------------------------------------------------------------------------
"   Mappings
" -----------------------------------------------------------------------------

" Press Enter in normal mode to clear search highlighting
nnoremap <CR> :silent! nohls<CR>

" j/k move by visual line (useful when a long line wraps to multiple screen lines)
nnoremap j gj
nnoremap k gk

" Quick escape from insert mode (type jk or kj instead of reaching for Esc)
inoremap jk <ESC>
inoremap kj <ESC>

" Y yanks to end of line (consistent with D and C which also act to end of line)
map Y y$

" ,u uppercases the current word
nnoremap <Leader>u gUiwe
inoremap <Leader>u <ESC>gUiwea

" ,w to save, ,q to quit (works in both normal and insert mode)
inoremap <Leader>w <ESC>:w<CR>
nnoremap <Leader>w :w<CR>
inoremap <Leader>q <ESC>:q<CR>
nnoremap <Leader>q :q<CR>

" Space toggles code fold (za = toggle fold under cursor)
nnoremap <Space> za

" Search & replace: press * to highlight a word, then:
"   ,r   → replace all occurrences in file
"   ,rc  → replace with confirmation for each
nnoremap <Leader>r :%s///g<Left><Left>
nnoremap <Leader>rc :%s///gc<Left><Left><Left>

" Same as above but restricted to visual selection
xnoremap <Leader>r :s///g<Left><Left>
xnoremap <Leader>rc :s///gc<Left><Left><Left>

" Buffer navigation
nnoremap <Tab> :bnext<CR>         " Tab → next buffer
nnoremap <S-Tab> :bprev<CR>       " Shift-Tab → previous buffer
nnoremap <Leader><Space> :b#<CR>  " ,Space → toggle between last two buffers
nnoremap Q :bd!<CR>               " Q → close current buffer

" ,g → jump to definition of symbol under cursor (via ALE/LSP)
map <Leader>g :ALEGoToDefinition<CR>

" Ctrl-n → toggle file explorer sidebar (NERDTree)
map <C-n> :NERDTreeToggle<CR>

" FZF (fuzzy finder) mappings
nnoremap <silent> <C-f> :Files<CR>       " Ctrl-f → find files in current directory
nnoremap <silent> <Leader>b :Buffers<CR> " ,b → search open buffers
nnoremap <silent> <Leader>L :Lines<CR>   " ,L → search lines across all buffers
nnoremap <silent> <Leader>l :BLines<CR>  " ,l → search lines in current buffer

" VimWiki: ,wf → search wiki for a pattern
nnoremap <Leader>wf :VWS //<Left>

" ,ev → open vimrc in vertical split for quick editing
" ,sv → reload vimrc without restarting Vim
nnoremap <Leader>ev :vsplit $MYVIMRC<CR>
nnoremap <Leader>sv :source $MYVIMRC<CR>

" H/L → jump to start/end of line (easier than ^ and $)
nnoremap H ^
nnoremap L $
" J/K → move 5 lines at a time (faster scrolling than j/k)
nnoremap J 5j
nnoremap K 5k


" -----------------------------------------------------------------------------
"   Plugin settings
" -----------------------------------------------------------------------------

" Polyglot: disable red highlighting of trailing spaces in Python files
let g:python_highlight_space_errors = 0

" VimWiki: personal wiki stored as markdown files in ~/vimwiki/
" Open with `vw` shell alias or :VimwikiIndex
let g:vimwiki_list = [{'path': '~/vimwiki/', 'syntax': 'markdown', 'ext': '.md'}]

" NERDTree: file explorer sidebar (toggle with Ctrl-n)
let NERDTreeIgnore = ['\.pyc$', '\.pyo$', '__pycache__', '.ipynb_checkpoints']
let NERDTreeQuitOnOpen=1         " close tree after opening a file
let NERDTreeNaturalSort=1        " sort file1, file2, file10 (not file1, file10, file2)
let NERDTreeShowHidden=1         " show dotfiles
let NERDTreeAutoDeleteBuffer=1   " remove buffer when file is deleted from tree

" Lightline: status bar at the bottom of Vim
" Shows: mode | readonly | filename | modified   ...   line:col | percent
let g:lightline = {'colorscheme': 'wombat'}
let g:lightline.active = {'left': [['mode', 'paste'], ['readonly', 'filename', 'modified']]}
let g:lightline.active = {'right': [['lineinfo'], ['percent']]}


" -----------------------------------------------------------------------------
"   ALE (Asynchronous Lint Engine)
" -----------------------------------------------------------------------------
" ALE provides linting (error checking) and basic code completion for Python.
" It runs linters in the background without blocking Vim.
"
" Linting is set to manual-only (not on save, not on text change).
" To lint manually:  :ALELint
" To fix manually:   :ALEFix
" To go to def:      ,g

" Linters: flake8 for style, pylsp for language features
let g:ale_linters = {'python': ['flake8', 'pylsp']}

" Configure pylsp: disable redundant checks (flake8 already handles these)
let g:ale_python_pyls_executable = "pylsp"
let g:ale_python_pyls_config = {
\   'pylsp': {
\     'plugins': {
\       'pycodestyle': { 'enabled': v:false },
\       'pyflakes':    { 'enabled': v:false },
\       'pydocstyle':  { 'enabled': v:false },
\     },
\   },
\}

" When to lint (all disabled = manual only via :ALELint)
let g:ale_set_highlights = 0            " don't highlight errors inline
let g:ale_lint_on_text_changed = 'never' " don't lint while typing
let g:ale_lint_on_enter = 0             " don't lint when opening a file
let g:ale_lint_on_save = 0              " don't lint on save

" Fixers: applied with :ALEFix (or automatically if ale_fix_on_save=1)
let g:ale_fixers = {'*': ['remove_trailing_lines', 'trim_whitespace']}
let g:ale_fix_on_save = 0              " don't auto-fix on save

" Gutter signs for errors/warnings (shown in the left margin)
highlight clear ALEErrorSign
highlight clear ALEWarningSign
let g:ale_sign_error = '✗'
let g:ale_sign_warning = '.'

" Enable ALE's built-in code completion (uses pylsp)
let g:ale_completion_enabled=1

" Don't auto-detect conda/virtualenv — use whatever Python is active in shell
let g:ale_virtualenv_dir_names = []


" -----------------------------------------------------------------------------
"   Vim-Slime (send code to REPL)
" -----------------------------------------------------------------------------
" Slime sends code from Vim to a running IPython session in a tmux pane.
" Workflow: open a tmux split, start IPython there, then from Vim use
" Ctrl-c Ctrl-c to send the current cell/selection to IPython.
let g:slime_target = 'tmux'           " send to a tmux pane (not screen, etc.)
let g:slime_python_ipython = 1        " use %paste for clean IPython pasting

" Automatically target the top-right tmux pane (no prompt asking where to send)
let g:slime_default_config = {
            \ 'socket_name': get(split($TMUX, ','), 0),
            \ 'target_pane': '{top-right}' }
let g:slime_dont_ask_default = 1


" -----------------------------------------------------------------------------
"   FZF
" -----------------------------------------------------------------------------
" When fzf previews files, use bat with this theme for syntax-highlighted preview
let $BAT_THEME = 'Solarized (dark)'


" -----------------------------------------------------------------------------
"   Window management
" -----------------------------------------------------------------------------
" When terminal is resized (e.g., toggling tmux zoom), rebalance all Vim splits
autocmd VimResized * :wincmd =

" ,~ → zoom current split to fill screen (like tmux zoom but for Vim splits)
" ,= → rebalance all splits back to equal size
nnoremap <Leader>~ :wincmd _<CR>:wincmd \|<CR>
nnoremap <Leader>= :wincmd =<CR>

" When switching buffers, remember scroll position so you return to the
" same spot (not the top of the file). Without this, :bnext then :bprev
" loses your place.
if v:version >= 700
   au BufLeave * if !&diff | let b:winview = winsaveview() | endif
   au BufEnter * if exists('b:winview') && !&diff | call   winrestview(b:winview) | endif
endif
